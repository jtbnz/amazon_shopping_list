# Amazon Shopping List Scraper - Configuration
# Copy this file to .env and fill in your values.

# Amazon account credentials
AMZ_LOGIN=your-amazon-email@example.com
AMZ_PASS=your-amazon-password

# TOTP secret key for 2-step verification (Base32, no spaces).
# Leave empty or omit if you don't use 2-step verification.
# See README for how to obtain this key.
AMZ_SECRET=YOUROTPSECRETBASE32NOSPACESHERE

# Home Assistant webhook URL
# Created via an automation blueprint in HA that accepts a webhook trigger.
HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/your-webhook-id

# Amazon sign-in URL for your region.
# United States:
Amazon_Sign_in_URL=https://www.amazon.com/ap/signin?openid.pape.max_auth_age=3600&openid.return_to=https%3A%2F%2Fwww.amazon.com%2Falexaquantum%2Fsp%2FalexaShoppingList%3Fref_%3Dlist_d_wl_ys_list_1&openid.identity=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0%2Fidentifier_select&openid.assoc_handle=amzn_alexa_quantum_us&openid.mode=checkid_setup&language=en_US&openid.claimed_id=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0%2Fidentifier_select&openid.ns=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0
# Australia:
# Amazon_Sign_in_URL=https://www.amazon.com.au/ap/signin?openid.pape.max_auth_age=3600&openid.return_to=https%3A%2F%2Fwww.amazon.com.au%2Falexaquantum%2Fsp%2FalexaShoppingList%3Fref_%3Dlist_d_wl_ys_list_1&openid.identity=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0%2Fidentifier_select&openid.assoc_handle=amzn_alexa_quantum_au&openid.mode=checkid_setup&language=en_AU&openid.claimed_id=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0%2Fidentifier_select&openid.ns=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0
# Italy:
# Amazon_Sign_in_URL=https://www.amazon.it/ap/signin?openid.pape.max_auth_age=0&openid.return_to=https%3A%2F%2Fwww.amazon.it%2Fref%3Dnav_signin&openid.identity=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0%2Fidentifier_select&openid.assoc_handle=itflex&openid.mode=checkid_setup&openid.claimed_id=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0%2Fidentifier_select&openid.ns=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0

# Amazon Shopping List URL for your region.
# United States:
Amazon_Shopping_List_Page=https://www.amazon.com/alexaquantum/sp/alexaShoppingList?ref_=list_d_wl_ys_list_1
# Australia:
# Amazon_Shopping_List_Page=https://www.amazon.com.au/alexaquantum/sp/alexaShoppingList?ref_=list_d_wl_ys_list_1
# Italy:
# Amazon_Shopping_List_Page=https://www.amazon.it/alexaquantum/sp/alexaShoppingList?ref_=list_d_wl_ys_list_1

# Optional: path to Chromium/Chrome binary (defaults to /usr/bin/google-chrome)
# CHROMIUM_PATH=/usr/bin/google-chrome

# Optional: set to "true" to enable verbose debug output and screenshots in www/
# log_level=false
